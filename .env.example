# Base URL of the backend REST API (no trailing slash).
# The Express backend is expected to serve routes under this prefix.
VITE_API_BASE_URL=http://localhost:5000/api

# true  -> every service uses the isolated mock layer in src/mock/
# false -> every service calls the real backend through src/services/api.js
VITE_USE_MOCK=true

# Simulated network latency for mock responses, in milliseconds.
VITE_MOCK_LATENCY_MS=400
